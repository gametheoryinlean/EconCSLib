import EconCSLib.OpenProblem.EconCSBench.Common

namespace EconCSLib.OpenProblem.EconCSBench.DeterministicSubadditiveCA

/-- A deterministic mechanism for subadditive combinatorial auctions. -/
abbrev SubadditiveMechanism
    (I : Type*) {G : Type*} [DecidableEq G] (M : Finset G) :=
  DeterministicBundleMechanism I (SubadditiveBundleValuation M) M

/-- The value extractor used in the quasi-linear DSIC condition. -/
def reportedValue
    {G : Type*} [DecidableEq G] {M : Finset G}
    (v : SubadditiveBundleValuation M) : BundleAllocation M → ℝ :=
  v.val

/-- A mechanism achieves the welfare approximation factor `α`. -/
noncomputable def AchievesWelfareFactor
    {I G : Type*} [Fintype I] [DecidableEq I] [DecidableEq G]
    {M : Finset G}
    (α : ℝ) (mechanism : SubadditiveMechanism I M) : Prop :=
  ∀ reports : I → SubadditiveBundleValuation M,
    α * bundleOPT (fun i => (reports i).val) ≤
      bundleSocialWelfare (fun i => (reports i).val)
        (mechanism.allocation reports)

/-- Communication bounded by one already fixed polynomial in the bit model
specified by `PROBLEM.md`.  Each bidder initially sees only its own valuation
report; a protocol leaf determines the allocation and all payments from the
exchanged bit strings.  Communication is therefore the length of the actual
transcript generated by the protocol syntax, not a separately supplied cost. -/
def SubadditiveMechanism.HasBitCommunicationBound
    {I G : Type*} [Fintype I] [DecidableEq G] {M : Finset G}
    (mechanism : SubadditiveMechanism I M)
    (coefficient exponent : ℕ) : Prop :=
  ∃ protocol : CommunicationProtocol (Party := I)
      (PrivateInput := fun _ => SubadditiveBundleValuation M)
      (Message := List Bool)
      (fun reports =>
        (mechanism.allocation reports, mechanism.payment reports)),
    protocol.HasCommunicationBound coefficient exponent List.length fun _ =>
      [M.card, Fintype.card I]

/-- Open-problem statement: a deterministic DSIC 2-approximation with
polynomial communication exists for every finite combinatorial-auction
domain. -/
def DeterministicSubadditiveTwoApproximationStatement : Prop :=
  ∃ coefficient exponent : ℕ,
    ∀ (I G : Type*) [Fintype I] [DecidableEq I] [DecidableEq G]
        [Nonempty I] (M : Finset G),
      ∃ mechanism : SubadditiveMechanism I M,
        mechanism.IsDSIC reportedValue ∧
        mechanism.HasBitCommunicationBound coefficient exponent ∧
        AchievesWelfareFactor (1 / 2 : ℝ) mechanism

/-- English version: "Is there a polynomial-communication deterministic DSIC
mechanism attaining a 2-approximation for subadditive combinatorial auctions?" -/
theorem deterministicSubadditiveTwoApproximation :
    answer(sorry) ↔ DeterministicSubadditiveTwoApproximationStatement := by
  sorry

end EconCSLib.OpenProblem.EconCSBench.DeterministicSubadditiveCA
